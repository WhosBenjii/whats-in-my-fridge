# Réglages en local (à copier dans un fichier .env ou à taper dans le terminal avec export).
# Tous sont facultatifs : sans rien, l'appli marche en mode démo avec un fichier local.

# La clé de l'IA
ANTHROPIC_API_KEY=sk-ant-ta-cle-ici

# Budget : nombre total de scans autorisés pour toute l'appli
MAX_SCANS_TOTAL=200

# Le compte qui voit les signalements, les avis et le budget d'IA
ADMIN_EMAIL=ton.email@exemple.com

# La base en ligne (sinon, fichier data/fridge.db)
# DATABASE_URL=postgresql://utilisateur:motdepasse@serveur:5432/basededonnees

# Pour telecharger_photos.py
# PIXABAY_API_KEY=ta-cle-pixabay
