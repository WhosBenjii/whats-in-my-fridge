# À coller sur Streamlit Cloud, dans « Settings » puis « Secrets ».
# En local, tu peux créer .streamlit/secrets.toml (il n'est jamais envoyé sur GitHub).

# La clé de l'IA. Sans elle, l'appli marche en mode démo avec des exemples.
ANTHROPIC_API_KEY = "sk-ant-ta-cle-ici"

# Budget : nombre total de scans autorisés pour toute l'appli. Au-delà, l'IA se coupe
# toute seule. 200 scans avec le modèle Haiku coûtent environ 8 centimes.
MAX_SCANS_TOTAL = "200"

# La base de données en ligne (Supabase, Neon…). Sans elle, les données repartent
# à zéro à chaque redémarrage du serveur.
DATABASE_URL = "postgresql://utilisateur:motdepasse@serveur:5432/basededonnees"

# Ton adresse dans l'appli : c'est ce compte qui voit les signalements et les avis.
ADMIN_EMAIL = "ton.email@exemple.com"

# Pour télécharger les photos des recettes (facultatif).
PIXABAY_API_KEY = "ta-cle-pixabay-ici"
